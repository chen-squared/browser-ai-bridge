PORT=3010
HOST=127.0.0.1
HEADLESS=false
USER_DATA_DIR=.sessions/chromium
DEFAULT_PROVIDER=chatgpt
SELECTOR_OVERRIDES_PATH=selectors.overrides.json
# BROWSER_CHANNEL=chrome
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── 访问控制 ────────────────────────────────────────────────
# 只监听 127.0.0.1 并不足以自保。浏览器的同源策略按主机名判断，
# 恶意域名用 DNS rebinding 解析到 127.0.0.1 后，请求在浏览器看来是同源的。
# 因此服务端默认校验 Host 头，默认放行 localhost / 127.0.0.1 / ::1。
# 需要用别的域名或局域网 IP 访问时，在这里显式列出（逗号分隔）。
# ALLOWED_HOSTS=my-laptop.local,192.168.1.20

# 设置后，除 /health 和控制台页面外的所有接口都要求携带 token（至少 16 位）。
# 控制台用 http://127.0.0.1:3010/?token=<值> 打开一次即可，token 会存在
# sessionStorage 里；脚本调用请带 Authorization: Bearer <值>。
# 生成方式：openssl rand -hex 24
# BRIDGE_TOKEN=

# 出错时是否自动把对应标签页切到前台。默认 false。
#
# 原来默认开启，实测在 macOS 上会频繁把浏览器窗口拽到前台，干扰同一台机器上的
# 其他操作——尤其未登录时那90 秒等待超时，几乎每错一次就跳一次。
# 卡住时想看一眼，用控制台的"打开"按钮即可，那条路径不受此开关影响。
# REVEAL_ON_ERROR=true

# 不设置 = 只允许同源访问。跨源时在这里按逗号分隔列出允许的 Origin。
# CORS_ORIGIN=https://my-frontend.example.com

# 会议记录落盘位置。会议的多轮与历史靠它，不存就没有第二次。
# MEETING_STORE_PATH=.sessions/meetings.json
